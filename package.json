{
  "name": "formatter-chatgpt-telegram",
  "version": "0.1.0",
  "description": "A package for converting markdown to HTML for chat Telegram bots",
  "main": "lib",
  "module": "lib/esm",
  "types": "lib/index.d.ts",
  "scripts": {
    "test": "jest",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "build:types": "tsc --emitDeclarationOnly",
    "build:cjs": "tsc -m commonjs --declarationDir lib --outDir lib",
    "build:esm": "tsc -m esNext --declarationDir lib/esm --outDir lib/esm",
    "build": "npm run build:types && npm run build:cjs && npm run build:esm",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "markdown",
    "telegram",
    "html",
    "converter",
    "chatgpt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zamarawka/formatter-chatgpt-telegram.git"
  },
  "author": "zamarawka <somebody.told@mail.ru> (https://github.com/zamarawka)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zamarawka/formatter-chatgpt-telegram/issues"
  },
  "homepage": "https://github.com/zamarawka/formatter-chatgpt-telegram#readme",
  "devDependencies": {
    "@jest/types": "^29.6.3",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.11",
    "jest": "^29.5.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.4"
  }
}
